{
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"lib": ["ES2022", "DOM"],
		"types": ["node"],
		"rootDir": "src",
		"outDir": "out",
		"strict": true,
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": false
	},
	"include": ["src/**/*.ts"]
}
